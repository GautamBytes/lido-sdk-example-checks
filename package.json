{
  "name": "lido-sdk-example-checks",
  "version": "0.1.0",
  "private": true,
  "description": "Typechecked Lido SDK examples, reproducible documentation fixes, and deterministic read-path tests.",
  "type": "module",
  "license": "MIT",
  "author": "Gautam Manchandani (GautamBytes)",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check:types": "tsc --noEmit",
    "check:docs": "node scripts/check-docs.mjs",
    "check:live": "node scripts/check-live.mjs",
    "check:transactions": "node scripts/check-transactions.mjs",
    "verify": "node scripts/verify.mjs",
    "check": "npm run check:types && npm run check:docs && npm test",
    "reproduce": "node scripts/reproduce.mjs",
    "demo": "node --import tsx src/initialize.ts"
  },
  "dependencies": {
    "@lidofinance/lido-ethereum-sdk": "4.8.0",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.20.6",
    "@types/node": "22.18.6"
  }
}
